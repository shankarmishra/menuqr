{
  "installCommand": "npm install",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/admin/login",
      "destination": "https://admin.menusqr.in/login",
      "permanent": true,
      "has": [{ "type": "host", "value": "menusqr.in" }]
    },
    {
      "source": "/admin/login",
      "destination": "https://admin.menusqr.in/login",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.menusqr.in" }]
    },
    {
      "source": "/admin",
      "destination": "https://admin.menusqr.in/login",
      "permanent": true,
      "has": [{ "type": "host", "value": "menusqr.in" }]
    },
    {
      "source": "/admin",
      "destination": "https://admin.menusqr.in/login",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.menusqr.in" }]
    },
    {
      "source": "/admin/",
      "destination": "https://admin.menusqr.in/login",
      "permanent": true,
      "has": [{ "type": "host", "value": "menusqr.in" }]
    },
    {
      "source": "/admin/",
      "destination": "https://admin.menusqr.in/login",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.menusqr.in" }]
    },
    {
      "source": "/admin/:path*",
      "destination": "https://admin.menusqr.in/admin/:path*",
      "permanent": true,
      "has": [{ "type": "host", "value": "menusqr.in" }]
    },
    {
      "source": "/admin/:path*",
      "destination": "https://admin.menusqr.in/admin/:path*",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.menusqr.in" }]
    },
    {
      "source": "/digital-menu-pricing",
      "destination": "/plans",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/refund-policy",
      "destination": "/refund-cancellation",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/index"
    }
  ]
}
