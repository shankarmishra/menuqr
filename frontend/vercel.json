{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/admin/login",
      "destination": "https://admin.menusqr.in/login",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "menusqr.in"
        }
      ]
    },
    {
      "source": "/admin/login",
      "destination": "https://admin.menusqr.in/login",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "www.menusqr.in"
        }
      ]
    },
    {
      "source": "/admin",
      "destination": "https://admin.menusqr.in/login",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "menusqr.in"
        }
      ]
    },
    {
      "source": "/admin",
      "destination": "https://admin.menusqr.in/login",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "www.menusqr.in"
        }
      ]
    },
    {
      "source": "/admin/",
      "destination": "https://admin.menusqr.in/login",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "menusqr.in"
        }
      ]
    },
    {
      "source": "/admin/",
      "destination": "https://admin.menusqr.in/login",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "www.menusqr.in"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "destination": "https://admin.menusqr.in/admin/:path*",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "menusqr.in"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "destination": "https://admin.menusqr.in/admin/:path*",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "www.menusqr.in"
        }
      ]
    },
    {
      "source": "/digital-menu-pricing",
      "destination": "/plans",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/refund-policy",
      "destination": "/refund-cancellation",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/login",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "admin.menusqr.in"
        }
      ]
    },
    {
      "source": "/:page(plans|digital-qr-menu|restaurant-qr-menu|digital-menu-for-restaurants|qr-menu-for-restaurants|restaurant-digital-menu|qr-ordering-for-restaurants|how-it-works|templates|about|contact|faq|privacy|terms|refund-cancellation)",
      "destination": "https://menusqr.in/:page",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "admin.menusqr.in"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:section(app|admin|menu|qr|audit-preview|purchase)/:path*",
      "destination": "/index"
    },
    {
      "source": "/:page(app|admin|template-showcase|showcase|audit-preview)",
      "destination": "/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://checkout.razorpay.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https: wss:; frame-src 'self' https://api.razorpay.com https://checkout.razorpay.com https://*.firebaseapp.com https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "admin.menusqr.in"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-site"
        }
      ]
    }
  ]
}
