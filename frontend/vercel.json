{
  "cleanUrls": true,
  "routes": [
    {
      "src": "/admin/login",
      "dest": "https://admin.menusqr.in/login",
      "status": 302,
      "has": [{ "type": "host", "value": "menusqr.in" }]
    },
    {
      "src": "/admin/(.*)",
      "dest": "https://admin.menusqr.in/admin/$1",
      "status": 302,
      "has": [{ "type": "host", "value": "menusqr.in" }]
    },
    {
      "src": "/admin/login",
      "dest": "https://admin.menusqr.in/login",
      "status": 302,
      "has": [{ "type": "host", "value": "www.menusqr.in" }]
    },
    {
      "src": "/admin/(.*)",
      "dest": "https://admin.menusqr.in/admin/$1",
      "status": 302,
      "has": [{ "type": "host", "value": "www.menusqr.in" }]
    },
    {
      "src": "/digital-menu-pricing",
      "dest": "/plans",
      "status": 301
    },
    {
      "src": "/privacy-policy",
      "dest": "/privacy",
      "status": 301
    },
    {
      "src": "/refund-policy",
      "dest": "/refund-cancellation",
      "status": 301
    },
    { "handle": "filesystem" },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
