{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/admin/login",
      "destination": "https://admin.menusqr.in/login",
      "permanent": false,
      "has": [{ "type": "host", "value": "menusqr.in" }]
    },
    {
      "source": "/admin/:path*",
      "destination": "https://admin.menusqr.in/admin/:path*",
      "permanent": false,
      "has": [{ "type": "host", "value": "menusqr.in" }]
    },
    {
      "source": "/admin/login",
      "destination": "https://admin.menusqr.in/login",
      "permanent": false,
      "has": [{ "type": "host", "value": "www.menusqr.in" }]
    },
    {
      "source": "/admin/:path*",
      "destination": "https://admin.menusqr.in/admin/:path*",
      "permanent": false,
      "has": [{ "type": "host", "value": "www.menusqr.in" }]
    },
    {
      "source": "/digital-menu-pricing",
      "destination": "/plans",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/refund-policy",
      "destination": "/refund-cancellation",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|marketing/|sitemap\\.xml|robots\\.txt|favicon\\.svg|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
